# WaJato — copie para `.env` e preencha. NUNCA commite o `.env` com valores reais.
# Subir a infra: `docker compose up -d` (Postgres, Redis e Evolution Go).
# Depois: `npm install && npx prisma db push && npx prisma generate && npm run build`
# (ver deploy.sh para o fluxo completo com PM2).

# --- Banco do app (serviço wajato-db no docker-compose) ---
POSTGRES_USER=wajato
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=wajato_db
DATABASE_URL=postgresql://wajato:troque-por-uma-senha-forte@localhost:5432/wajato_db?schema=public

# --- Redis do app (serviço wajato-redis; filas BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Evolution Go (serviço wajato-evolution; gateway de WhatsApp) ---
# URL que o app usa para falar com o gateway.
EVOLUTION_API_URL=http://localhost:8080
# Chave global do gateway — DEVE ser o mesmo valor de GLOBAL_API_KEY do
# container (o compose lê esta variável). Gere uma com: openssl rand -hex 32
EVOLUTION_API_KEY=troque-por-uma-chave-forte
# Nome da instância padrão criada no gateway.
EVOLUTION_INSTANCE_NAME=wajato-session

# --- IA: Luna via proxy teamsoclo (NÃO é OpenRouter) ---
# O chatbot e o aquecimento usam a Luna quando AI_PROVIDER=luna.
AI_PROVIDER=luna
# URL base do proxy teamsoclo (o código chama POST {LUNA_BASE_URL}/chat/completions).
# Use o mesmo valor de OPENROUTER_BASE_URL do backend do ZapIA/EcoSis.
LUNA_BASE_URL=https://SEU-PROXY-TEAMSOCLO/v1
# Chave bearer da Luna. O nome da variável é histórico (era a chave do
# Gemini); o valor guardado é a chave da IA. Pode ser preenchida aqui ou
# na tela de configuração do chatbot (campo "Chave da IA (Luna via teamsoclo)").
GEMINI_API_KEY=sua-chave-luna-aqui

# --- App ---
APP_URL=https://wajato.ftech-apps.com.br
NEXT_PUBLIC_APP_URL=https://wajato.ftech-apps.com.br
NODE_ENV=production
# Segredo do JWT (login). Gere um com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte

# --- Admin inicial (prisma/seed.ts) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# --- Google OAuth (opcional; só se for usar login com Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Webshare (proxies p/ aquecimento; opcional) ---
WEBSHARE_API_KEY=
